{
  "name": "workout-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "node --import tsx --test tests/*.test.mjs tests/*.test.ts",
    "privacy:check": "node scripts/privacy-check.mjs",
    "build:backend": "esbuild backend/index.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/backend/index.mjs --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\"",
    "test:e2e": "playwright test",
    "scan:build": "node scripts/scan-artifacts.mjs build",
    "test:bundle": "npm run build:backend && node scripts/smoke-backend.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.57.0",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/aws-lambda": "8.10.163",
    "@types/node": "22.20.4",
    "esbuild": "0.28.2",
    "fake-indexeddb": "6.2.5",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.1"
  },
  "overrides": {
    "cookie": "0.7.2"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1141.0",
    "@aws-sdk/client-ssm": "3.1141.0",
    "@aws-sdk/lib-dynamodb": "3.1141.0",
    "aws-jwt-verify": "5.2.1",
    "idb": "8.0.3",
    "oidc-client-ts": "3.5.0",
    "zod": "4.6.5"
  }
}
