# Browser identifiers are public. Never put credentials in PUBLIC_ values.
# Lambda function URL (stack output ApiUrl)
PUBLIC_API_URL=
# https://cognito-idp.<region>.amazonaws.com/<user-pool-id> (stack output Authority)
PUBLIC_COGNITO_AUTHORITY=
# Public app client ID (stack output ClientId)
PUBLIC_COGNITO_CLIENT_ID=
# https://<prefix>.auth.<region>.amazoncognito.com (stack output AuthDomain)
PUBLIC_COGNITO_DOMAIN=
# Empty for a custom domain; /repository-name for a GitHub project URL.
BASE_PATH=
# Only for local browser tests: enables a device-only preview with synthetic data.
PUBLIC_LOCAL_PREVIEW=
# Google secrets and the owner allowlist belong in server-side configuration.
